# In Colab, put these in the Secrets panel (key icon) instead of a file. Never commit a real .env.

# --- Network (Tailscale + LiveKit) ---
TAILSCALE_AUTH_KEY=            # ephemeral, tagged key
LIVEKIT_HOST=                  # IPv4 of your LiveKit host on the tailnet, e.g. 100.x.y.z
LIVEKIT_URL=                   # optional, default ws://$LIVEKIT_HOST:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PBX_HOST=                      # optional, FreePBX tailnet IP, only used to keep the route warm

# --- Dialer ---
DIALER_API_KEY=                # long random string; n8n sends it as header X-Api-Key
TATA_PILOT_CLI=                # caller-ID / pilot number of your SIP trunk
SIP_TRUNK_ID=                  # optional if you only have one outbound trunk
MAX_CONCURRENT_CALLS=2
CALL_WINDOW=10:00-20:00        # IST; empty disables the check

# --- n8n ---
N8N_WHATSAPP_WEBHOOK=          # default http://$LIVEKIT_HOST:5678/webhook/send-b2b-link
N8N_CRM_UPDATE_WEBHOOK=        # default http://$LIVEKIT_HOST:5678/webhook/update-twenty-crm
N8N_WEBHOOK_SECRET=            # REQUIRED if the webhook URLs are public; sent as X-Api-Key
CALLBACK_ALLOWED_HOSTS=        # extra hosts allowed as callback_url, comma-separated

# --- Models ---
HF_TOKEN=                      # only for gated downloads
TEST_PHONE=                    # number used by the test-call cell
